generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         String // MITRA, VENDOR, VM, SM, GM, COO
  status       String        @default("ACTIVE") // ACTIVE, INACTIVE, PENDING
  phone        String?
  avatar       String?       @db.Text
  vendorId     String?
  vendor       Vendor?       @relation(fields: [vendorId], references: [id])
  mitraProfile MitraProfile?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  attendances        Attendance[]
  sentApprovals      Approval[]       @relation("ApprovalCreator")
  handledApprovals   Approval[]       @relation("ApprovalHandler")
  osRequests         OSRequest[]      @relation("OSRequestCreator")
  accountRequests    AccountRequest[] @relation("AccountRequestCreator")
  handledAccountReqs AccountRequest[] @relation("AccountRequestHandler")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  address   String?  @db.Text
  phone     String?
  email     String?
  status    String   @default("PENDING") // PENDING, ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  mitraProfiles MitraProfile[]
  claims        Claim[]
  invoices      Invoice[]
  osRequests    OSRequest[]    @relation("OSRequestVendor")
}

model MitraProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  idMitraOs      String?
  nik            String?
  tempatLahir    String?
  tanggalLahir   DateTime?
  alamat         String?   @db.Text
  kelurahan      String?
  kecamatan      String?
  kabKota        String?
  provinsi       String?
  noBpjs         String?
  noRekening     String?
  namaBank       String?
  fotoKtp        String?   @db.LongText
  jenisSim       String?
  noSim          String?
  fotoSim        String?   @db.LongText
  fotoSelfie     String?   @db.LongText
  faceDescriptor String?   @db.Text
  penempatan     String?
  posisi         String?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, REPLACED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([idMitraOs])
}

model Attendance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  date         DateTime  @default(now())
  checkIn      DateTime?
  checkOut     DateTime?
  type         String    @default("HADIR") // HADIR, IZIN, SAKIT, ALPHA
  fotoCheckIn  String?   @db.LongText
  fotoCheckOut String?   @db.LongText
  latitude     Float?
  longitude    Float?
  note         String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model OSRequest {
  id           String   @id @default(cuid())
  type         String // PENAMBAHAN, PERGANTIAN, PENGURANGAN
  status       String   @default("PENDING") // PENDING, APPROVED_GM, APPROVED_COO, VENDOR_SELECTED, WAITING_SELECTION, WAITING_ACTIVATION, NOT_SELECTED, COMPLETED, REJECTED
  requesterId  String
  requester    User     @relation("OSRequestCreator", fields: [requesterId], references: [id])
  vendorId     String?
  vendor       Vendor?  @relation("OSRequestVendor", fields: [vendorId], references: [id])
  jumlah       Int      @default(1)
  idPergantian String?
  idMitraOs    String?
  posisi       String?
  penempatan   String?
  waktuKerja   String?
  alasan       String?  @db.Text
  catatan      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvals  Approval[]
  candidates Candidate[]
}

model Approval {
  id          String    @id @default(cuid())
  osRequestId String
  osRequest   OSRequest @relation(fields: [osRequestId], references: [id])
  approverId  String
  approver    User      @relation("ApprovalHandler", fields: [approverId], references: [id])
  creatorId   String
  creator     User      @relation("ApprovalCreator", fields: [creatorId], references: [id])
  level       String // GM, COO
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  catatan     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Candidate {
  id               String          @id @default(cuid())
  osRequestId      String
  osRequest        OSRequest       @relation(fields: [osRequestId], references: [id])
  name             String
  nik              String?
  fotoKtp          String?         @db.LongText
  jenisSim         String?
  noSim            String?
  fotoSim          String?         @db.LongText
  phone            String?
  email            String?
  alamat           String?         @db.Text
  kelurahan        String?
  kecamatan        String?
  kabKota          String?
  provinsi         String?
  namaBank         String?
  noRekening       String?
  accountRequestId String?         @unique
  accountRequest   AccountRequest? @relation(fields: [accountRequestId], references: [id])
  status           String          @default("KANDIDAT") // KANDIDAT, TERPILIH, DITOLAK, ACTIVATED
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AccountRequest {
  id          String     @id @default(cuid())
  type        String // VENDOR, MITRA
  name        String
  email       String
  phone       String?
  vendorId    String?
  requesterId String
  requester   User       @relation("AccountRequestCreator", fields: [requesterId], references: [id])
  handlerId   String?
  handler     User?      @relation("AccountRequestHandler", fields: [handlerId], references: [id])
  status      String     @default("PENDING") // WAITING_SELECTION, PENDING, APPROVED, REJECTED, ACTIVATED
  catatan     String?    @db.Text
  candidate   Candidate?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Claim {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  bulan       String // format: YYYY-MM
  jenisClaim  String // GAJI, BPJS, LEMBUR, TRANSPORT, etc.
  jumlahMitra Int
  nominal     Float
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  catatan     String?  @db.Text
  dokumen     String?  @db.LongText
  dokumenNama String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id                String    @id @default(cuid())
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  nomorInvoice      String    @unique
  bulan             String // format: YYYY-MM
  totalAmount       Float
  status            String    @default("DRAFT") // DRAFT, SUBMITTED, VERIFIED, PAID
  tanggalJatuhTempo DateTime?
  catatan           String?   @db.Text
  dokumen           String?   @db.LongText
  dokumenNama       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
